// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =================================
// ENUMS
// =================================

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  CASH
}

// ============================
// USER
// ============================

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  role        Role
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  customer         Customer?
  assignedPolicies Policy[]  @relation("AssignedPolicies")
  reviewedClaims   Claim[]   @relation("ReviewedClaims")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================
// CUSTOMER
// ============================

model Customer {
  id     String @id @default(uuid())
  userId String @unique

  fullName String
  phone    String   @unique
  dob      DateTime
  gender   Gender

  address    String
  city       String
  state      String
  country    String
  postalCode String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  policies  Policy[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================================
// POLICY TYPE
// ==================================

model PolicyType {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  policies Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =================================
// POLICY
// =================================

model Policy {
  id String @id @default(uuid())

  policyNumber String @unique

  customerId   String
  policyTypeId String
  agentId      String

  premiumAmount  Decimal @db.Decimal(12, 2)
  coverageAmount Decimal @db.Decimal(12, 2)

  description String?

  startDate DateTime
  endDate   DateTime

  issuedAt DateTime @default(now())

  status PolicyStatus @default(ACTIVE)

  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policyType    PolicyType @relation(fields: [policyTypeId], references: [id], onDelete: Restrict)
  assignedAgent User       @relation("AssignedPolicies", fields: [agentId], references: [id])

  premiumPayments PremiumPayment[]
  claims          Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================================
// PREMIUM PAYMENT
// ================================

model PremiumPayment {
  id String @id @default(uuid())

  policyId String

  amount Decimal @db.Decimal(12, 2)

  paymentDate DateTime

  paymentMethod PaymentMethod

  transactionId String?

  status PaymentStatus @default(PENDING)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =================================
// CLAIM
// =================================

model Claim {
  id String @id @default(uuid())

  claimNumber String @unique

  policyId String

  claimAmount Decimal @db.Decimal(12, 2)

  reason String

  remarks String?

  status ClaimStatus @default(PENDING)

  reviewedBy String?

  reviewedAt DateTime?

  resolvedAt DateTime?

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  reviewer User? @relation("ReviewedClaims", fields: [reviewedBy], references: [id])

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===============================
// DOCUMENT
// ===============================

model Document {
  id String @id @default(uuid())

  fileName String
  fileUrl  String
  mimeType String
  fileSize Int

  customerId String?
  claimId    String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  claim Claim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
